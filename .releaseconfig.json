{
  "plugins": ["iobroker", "license", "manual-review"],
  "versionFiles": [
    ["widgets/*.html", "(?<=Version: ')(.*?)(?=')"],
    ["widgets/trashschedule/js/*.js", "(?<=version: ')(.*?)(?=',)"]
  ],
  "exec": {
    "before_check": "npm run lint",
    "before_commit": "npm run update-readme"
  }
}
